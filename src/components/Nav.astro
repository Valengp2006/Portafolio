---
import { pagePath, other, type Lang, type PageKey } from "../i18n";
import { ui } from "../i18n/copy";

interface Props {
  lang: Lang;
  active?: PageKey | "";
  altHref: string;
}
const { lang, active = "", altHref } = Astro.props;

const links: { key: PageKey; label: string }[] = [
  { key: "about", label: ui.nav.about[lang] },
  { key: "projects", label: ui.nav.projects[lang] },
  { key: "services", label: ui.nav.services[lang] },
  { key: "contact", label: ui.nav.contact[lang] },
];
const alt = other(lang);
---
<header class="nav">
  <a href={pagePath(lang, "home")} class="nav-name">Valentina</a>
  <div class="nav-right">
    <nav class="nav-links" aria-label="Principal">
      {links.map((l) => (
        <a href={pagePath(lang, l.key)} class={active === l.key ? "is-active" : ""} aria-current={active === l.key ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="nav-lang" href={altHref} hreflang={alt} lang={alt} aria-label={ui.nav.switchLabel[lang]}>
      <span class={lang === "es" ? "on" : ""}>ES</span> / <span class={lang === "en" ? "on" : ""}>EN</span>
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--surface-warm);
    border-bottom: 1px solid var(--line);
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0 56px;
  }
  .nav-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    color: var(--ink);
    font-variation-settings: "SOFT" 0, "WONK" 1;
  }
  .nav-right { display: flex; align-items: center; gap: 40px; }
  .nav-links { display: flex; gap: 31px; }
  .nav-links a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .nav-links a.is-active { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .nav-lang {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .nav-lang, .nav-links a { white-space: nowrap; }
  .nav-lang .on { font-weight: 700; color: var(--ink); }
  .nav-lang:hover { border-color: var(--ink-muted); }

  @media (max-width: 900px) {
    .nav { padding: 10px 20px; }
    .nav-right { gap: 16px; }
    .nav-links { gap: 16px; }
  }
  @media (max-width: 560px) {
    .nav-right { width: 100%; justify-content: space-between; }
    .nav-links { gap: 12px; }
    .nav-links a { font-size: 13px; }
  }
</style>
