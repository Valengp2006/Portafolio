---
import type { Block } from "../data/projects";
import type { Lang } from "../i18n";

interface Props {
  blocks: Block[];
  lang: Lang;
  /** Color del proyecto: se usa solo en detalles pequeños (barras, citas). */
  accent?: string;
}
const { blocks, lang, accent = "#57504A" } = Astro.props;
const tr = (x: Record<Lang, string>) => x[lang];
const pad = (n: number) => String(n).padStart(2, "0");
---
<div class="vb-root" style={`--accent:${accent}`}>
{blocks.map((b) => (
  <section class="vb wrap reveal">
    {"label" in b && b.label && <h2 class="section-label vb-label">{tr(b.label)}</h2>}
    {"body" in b && b.body && b.type !== "statement" && b.type !== "quote" && <p class="vb-body">{tr(b.body)}</p>}

    {b.type === "facts" && (
      <div class="grid facts">
        {b.items.map((i) => (
          <div class="fact">
            <p class="fact-l">{tr(i.label)}</p>
            <p class="fact-v">{tr(i.value)}</p>
          </div>
        ))}
      </div>
    )}

    {b.type === "statement" && (
      <>
        <p class="statement">{tr(b.body)}</p>
        {b.tags && (
          <div class="tags">
            {b.tags.map((g) => <span class="chip">{tr(g.text)}</span>)}
          </div>
        )}
      </>
    )}

    {b.type === "cards" && (
      <div class="grid cards">
        {b.items.map((c, i) => (
          <div class="card">
            <span class="card-n">{pad(i + 1)}</span>
            <h3 class="card-t">{tr(c.title)}</h3>
            <p class="card-b">{tr(c.body)}</p>
          </div>
        ))}
      </div>
    )}

    {b.type === "sections" && (
      <div class="grid sec">
        {b.items.map((c, i) => (
          <article class="card sec-card">
            <span class="card-n">{pad(i + 1)}</span>
            <h3 class="card-t">{tr(c.label)}</h3>
            <p class="card-b">{tr(c.body)}</p>
          </article>
        ))}
      </div>
    )}

    {b.type === "steps" && (
      <ol class="grid steps">
        {b.items.map((c, i) => (
          <li class="card step-card">
            <span class="card-n">{pad(i + 1)}</span>
            <h3 class="card-t">{tr(c.title)}</h3>
            <p class="card-b">{tr(c.body)}</p>
          </li>
        ))}
      </ol>
    )}

    {b.type === "columns" && (
      <div class="grid cols">
        {b.items.map((c) => (
          <div class="col">
            <h3 class="col-h">{tr(c.title)}</h3>
            <ul class="col-ul">
              {c.bullets.map((x) => <li>{tr(x)}</li>)}
            </ul>
          </div>
        ))}
      </div>
    )}

    {b.type === "insight" && (
      <>
        <div class="grid cards three">
          {b.items.map((c) => (
            <div class="card">
              <span class="bar"></span>
              <h3 class="card-t">{tr(c.title)}</h3>
              <p class="card-b">{tr(c.body)}</p>
            </div>
          ))}
        </div>
        <div class="insight">
          <p class="insight-l">{lang === "es" ? "Insight principal" : "Key insight"}</p>
          <p class="insight-t">{tr(b.insight)}</p>
        </div>
      </>
    )}

    {b.type === "persona" && (
      <div class="persona">
        <div class="persona-top">
          <div class="persona-id">
            <p class="persona-name">{b.name}</p>
            <p class="persona-meta">{tr(b.age)}</p>
            <p class="persona-meta">{tr(b.role)}</p>
          </div>
          <blockquote class="persona-quote">{tr(b.quote)}</blockquote>
        </div>
        <div class="grid cols">
          {b.groups.map((g) => (
            <div class="col">
              <h3 class="col-h">{tr(g.title)}</h3>
              <ul class="col-ul">
                {g.items.map((x) => <li>{tr(x)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}

    {b.type === "palette" && (
      <div class="palette">
        <div class="swatches">
          {b.colors.map((c) => (
            <div class="sw">
              <span class="sw-dot" style={`background:${c.hex}`}></span>
              <span class="sw-n">{tr(c.name)}</span>
              <span class="sw-h">{c.hex}</span>
            </div>
          ))}
        </div>
        <div class="grid fonts">
          {b.fonts.map((f) => (
            <div class="font">
              <p class="font-n">{f.name}</p>
              <p class="font-d">{tr(f.note)}</p>
            </div>
          ))}
        </div>
        <div class="states">
          {b.states.map((s, i) => <span class={`state s${i}`}>{tr(s)}</span>)}
        </div>
      </div>
    )}

    {b.type === "flow" && (
      <ol class="flow">
        {b.steps.map((s, i) => (
          <li class="flow-s">
            <span class="flow-n">{i + 1}</span>
            <span class="flow-t">{tr(s)}</span>
          </li>
        ))}
      </ol>
    )}

    {b.type === "chips" && (
      <div class="tags">
        {b.items.map((c) => <span class="chip">{tr(c)}</span>)}
      </div>
    )}

    {b.type === "quote" && <blockquote class="big-quote">{tr(b.body)}</blockquote>}
  </section>
))}
</div>

<style>
  .vb { padding-top: 36px; padding-bottom: 36px; }
  .vb-label { margin: 0 0 14px; }
  .vb-body { font-size: 18px; line-height: 1.65; color: var(--ink-soft); margin: 0 0 22px; max-width: 900px; }
  .grid { display: grid; gap: 16px; }
  ol.grid { list-style: none; padding: 0; margin: 0; }

  /* Tarjetas neutras de la paleta del sitio */
  .card { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 16px; padding: 24px 24px 22px; }
  .card-n { display: inline-block; font-family: var(--font-display); font-weight: 600; font-size: 14px; letter-spacing: 0.04em; color: var(--ink-muted); margin-bottom: 10px; }
  .card-t { font-family: var(--font-display); font-weight: 600; font-size: 21px; line-height: 1.25; margin: 0 0 8px; color: var(--ink); }
  .card-b { font-size: 15.5px; line-height: 1.65; color: var(--ink-soft); margin: 0; }
  .bar { display: block; width: 40px; height: 4px; border-radius: 2px; margin-bottom: 14px; background: var(--accent); }

  .facts { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .fact { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
  .fact-l { font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 6px; }
  .fact-v { font-size: 17px; line-height: 1.45; color: var(--ink); margin: 0; }

  .statement { font-family: var(--font-display); font-size: 27px; line-height: 1.4; color: var(--ink); margin: 0 0 18px; max-width: 900px; font-variation-settings: "SOFT" 0, "WONK" 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { background: var(--surface-warm); border: 1px solid var(--line); color: var(--ink); font-size: 15px; padding: 9px 18px; border-radius: 999px; }

  .cards { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .cards.three { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .sec { grid-template-columns: 1fr 1fr; }
  .sec-card:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .steps { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .cols { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .col { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--surface); }
  .col-h { margin: 0; padding: 14px 20px; background: var(--surface-tag); border-bottom: 1px solid var(--line); color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: 19px; }
  .col-ul { margin: 0; padding: 18px 20px 14px 38px; }
  .col-ul li { font-size: 15px; line-height: 1.5; color: var(--ink-soft); margin-bottom: 8px; }

  .insight { margin-top: 26px; padding: 26px 0 24px; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); position: relative; }
  .insight::before { content: ""; position: absolute; top: -2px; left: 0; width: 64px; height: 4px; background: var(--accent); }
  .insight-l { font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 8px; }
  .insight-t { font-family: var(--font-display); font-size: 26px; line-height: 1.4; color: var(--ink); margin: 0; max-width: 900px; }

  .persona-top { display: grid; grid-template-columns: minmax(200px, 290px) 1fr; gap: 16px; align-items: stretch; margin-bottom: 16px; }
  .persona-id { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .persona-name { font-family: var(--font-display); font-size: 34px; margin: 0 0 6px; color: var(--ink); }
  .persona-meta { margin: 0 0 4px; font-size: 15px; color: var(--ink-soft); }
  .persona-quote { margin: 0; padding: 22px 4px 22px 0; border-top: 2px solid var(--ink); font-family: var(--font-display); font-size: 23px; line-height: 1.45; color: var(--ink); display: flex; align-items: center; }
  @media (max-width: 800px) { .persona-top { grid-template-columns: 1fr; } }

  .palette { display: grid; gap: 20px; }
  .swatches { display: flex; flex-wrap: wrap; gap: 18px; }
  .sw { display: flex; flex-direction: column; align-items: center; gap: 4px; min-width: 92px; }
  .sw-dot { width: 64px; height: 64px; border-radius: 16px; border: 1px solid rgba(0,0,0,0.15); }
  .sw-n { font-size: 13px; color: var(--ink); }
  .sw-h { font-size: 12px; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .fonts { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .font { background: var(--surface-tag); border: 1px solid var(--line); border-radius: 16px; padding: 22px; }
  .font-n { font-size: 26px; color: var(--ink); margin: 0 0 6px; font-weight: 700; }
  .font-d { font-size: 14px; color: var(--ink-soft); margin: 0; line-height: 1.5; }
  .states { display: flex; flex-wrap: wrap; gap: 10px; }
  .state { font-size: 14px; font-weight: 600; padding: 8px 18px; border-radius: 999px; background: var(--ink); color: var(--paper); }
  .state.s1 { background: var(--ink-soft); }
  .state.s2 { background: #3a342e; }
  .state.s3 { background: var(--line); color: var(--ink-muted); }

  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
  .flow-s { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .flow-n { width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--paper); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
  .flow-t { font-size: 14.5px; line-height: 1.45; color: var(--ink); }

  .big-quote { margin: 0; font-family: var(--font-display); font-size: 27px; line-height: 1.45; color: var(--ink); border-left: 4px solid var(--accent); padding-left: 24px; max-width: 900px; }

  @media (max-width: 900px) {
    .vb { padding-top: 26px; padding-bottom: 26px; }
    .statement, .big-quote { font-size: 22px; }
    .sec { grid-template-columns: 1fr; }
  }
</style>
