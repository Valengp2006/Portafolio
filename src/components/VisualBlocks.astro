---
import type { Block } from "../data/projects";
import { asset, type Lang } from "../i18n";
import { ui } from "../i18n/copy";

interface Props {
  blocks: Block[];
  lang: Lang;
  /** Color del proyecto: se usa solo en detalles pequeños (barras, citas). */
  accent?: string;
}
const { blocks, lang, accent = "#57504A" } = Astro.props;
const tr = (x: Record<Lang, string>) => x[lang];
const pad = (n: number) => String(n).padStart(2, "0");
// Los casos principales se dividen en secciones numeradas; dentro de ellas las etiquetas bajan a h3.
const chapters = blocks.filter((b) => b.type === "chapter");
const Label = chapters.length > 0 ? "h3" : "h2";
const galleryCols = (n: number) => (n === 1 ? "one" : n === 2 || n === 4 ? "two" : "");
---
<div class="vb-root" style={`--accent:${accent}`}>
{blocks.map((b) => b.type === "chapter" ? (
  <div class="vb-chapter wrap">
    <h2 class="chapter-title"><span class="chapter-n">{pad(chapters.indexOf(b) + 1)}</span>{tr(b.title)}</h2>
  </div>
) : (
  <section class="vb wrap reveal">
    {b.label && <Label class="section-label vb-label">{tr(b.label)}</Label>}
    {"body" in b && b.body && b.type !== "statement" && b.type !== "quote" && b.type !== "text" && <p class="vb-body">{tr(b.body)}</p>}

    {b.type === "text" && <p class="vb-text">{tr(b.body)}</p>}

    {b.type === "facts" && (
      <div class="grid facts">
        {b.items.map((i) => (
          <div class="fact">
            <p class="fact-l">{tr(i.label)}</p>
            <p class="fact-v">{tr(i.value)}</p>
          </div>
        ))}
      </div>
    )}

    {b.type === "statement" && <p class="statement">{tr(b.body)}</p>}

    {b.type === "cards" && (
      <div class="grid cards">
        {b.items.map((c, i) => (
          <div class="card">
            <span class="card-n">{pad(i + 1)}</span>
            <h4 class="card-t">{tr(c.title)}</h4>
            <p class="card-b">{tr(c.body)}</p>
          </div>
        ))}
      </div>
    )}

    {b.type === "steps" && (
      <ol class="grid steps">
        {b.items.map((c, i) => (
          <li class="card step-card">
            <span class="card-n">{pad(i + 1)}</span>
            <h4 class="card-t">{tr(c.title)}</h4>
            <p class="card-b">{tr(c.body)}</p>
          </li>
        ))}
      </ol>
    )}

    {b.type === "columns" && (
      <div class="grid cols">
        {b.items.map((c) => (
          <div class="col">
            <h4 class="col-h">{tr(c.title)}</h4>
            <ul class="col-ul">
              {c.bullets.map((x) => <li>{tr(x)}</li>)}
            </ul>
          </div>
        ))}
      </div>
    )}

    {b.type === "pairs" && (
      <div class={`grid pairs ${b.items.length % 2 === 0 ? "even" : ""}`}>
        {b.items.map((c) => (
          <div class="card">
            {c.title && <h4 class="card-t">{tr(c.title)}</h4>}
            <dl class="pair-dl">
              <dt>{tr(b.a)}</dt>
              <dd>{tr(c.a)}</dd>
              <dt class="pair-b">{tr(b.b)}</dt>
              <dd>{tr(c.b)}</dd>
            </dl>
          </div>
        ))}
      </div>
    )}

    {b.type === "flow" && (
      <ol class="flow">
        {b.steps.map((s, i) => (
          <li class="flow-s">
            <span class="flow-n">{i + 1}</span>
            <span class="flow-t">{tr(s)}</span>
          </li>
        ))}
      </ol>
    )}

    {b.type === "chips" && (
      <div class="tags">
        {b.items.map((c) => <span class="chip">{tr(c)}</span>)}
      </div>
    )}

    {b.type === "metrics" && (
      <div class="m-grid">
        {b.items.map((m) => (
          <div>
            <p class="m-v">{tr(m.value)}</p>
            <p class="m-l">{tr(m.label)}</p>
          </div>
        ))}
      </div>
    )}

    {b.type === "quote" && <blockquote class="big-quote">{tr(b.body)}</blockquote>}

    {b.type === "gallery" && (
      <div class={`gallery-grid ${galleryCols(b.items.length)}`}>
        {b.items.map((g) => (
          <figure>
            <img src={asset(g.src)} alt={tr(g.alt)} loading="lazy" />
            <figcaption>{tr(g.alt)}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {b.type === "videos" && (
      <div class={`videos-grid ${b.items.length === 1 ? "single" : b.items.length % 2 === 1 ? "odd" : ""}`}>
        {b.items.map((vd) => (
          <figure class={`video-card ${vd.vertical ? "vertical" : ""}`}>
            {vd.youtube ? (
              <div class="yt-frame" data-yt={vd.youtube} data-title={tr(vd.title)}>
                <button type="button" class="yt-play" aria-label={`${ui.project.playVideo[lang]}: ${tr(vd.title)}`}>
                  <img src={`https://i.ytimg.com/vi/${vd.youtube}/hqdefault.jpg`} alt="" loading="lazy" />
                  <span class="yt-icon" aria-hidden="true">▶</span>
                </button>
              </div>
            ) : (
              <video controls preload="none" playsinline poster={vd.poster ? asset(vd.poster) : undefined} src={vd.src ? asset(vd.src) : undefined} class="local-video" aria-label={tr(vd.title)}></video>
            )}
            <figcaption>{tr(vd.title)}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {b.type === "awards" && (
      <div class={`awards-grid ${b.items.length === 1 ? "one" : ""}`}>
        {b.items.map((a) => (
          <div class="award-card">
            {a.image && (
              <a href={asset(a.image)} target="_blank" rel="noopener" class="award-img-link">
                <img src={asset(a.image)} alt={`${lang === "es" ? "Certificado" : "Certificate"}: ${tr(a.title)}`} class="award-img" loading="lazy" />
              </a>
            )}
            <p class="award-title">★ {a.kind ? `${tr(a.kind)}, ` : ""}{tr(a.title)}</p>
            <p class="award-detail">{tr(a.detail)}</p>
          </div>
        ))}
      </div>
    )}

    {b.type === "links" && (
      <ul class="links">
        {b.items.map((l) => (
          <li><a href={l.url} target="_blank" rel="noopener" class="link-underline">{tr(l.label)} ↗</a></li>
        ))}
      </ul>
    )}
  </section>
))}
</div>

<script>
  document.querySelectorAll<HTMLElement>(".yt-frame").forEach((box) => {
    const btn = box.querySelector("button");
    btn?.addEventListener("click", () => {
      const id = box.dataset.yt;
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      f.title = box.dataset.title || "Video";
      f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      f.allowFullscreen = true;
      box.replaceChildren(f);
    });
  });
</script>

<style>
  .wrap { max-width: 1513px; margin: 0 auto; width: 100%; box-sizing: border-box; padding-left: 155px; padding-right: 155px; }
  .vb { padding-top: 22px; padding-bottom: 22px; }
  .vb-label { margin: 0 0 14px; }
  .vb-body { font-size: 18px; line-height: 1.65; color: var(--ink-soft); margin: 0 0 22px; max-width: 900px; }
  .vb-text { font-size: 18px; line-height: 1.65; color: var(--ink-soft); margin: 0; max-width: 900px; }
  .vb-chapter { padding-top: 40px; padding-bottom: 0; }
  .chapter-title { display: flex; align-items: baseline; gap: 16px; margin: 0; padding-top: 28px; border-top: 1px solid var(--line); font-family: var(--font-display); font-weight: 400; font-size: 34px; line-height: 1.2; color: var(--ink); }
  .chapter-n { font-size: 15px; font-weight: 600; letter-spacing: 0.06em; color: var(--ink-muted); }
  .vb-root > :first-child.vb-chapter { padding-top: 24px; }
  .vb-root > :first-child.vb-chapter .chapter-title { border-top: 0; padding-top: 8px; }
  .vb-root > :last-child { padding-bottom: 40px; }
  .grid { display: grid; gap: 16px; }
  ol.grid { list-style: none; padding: 0; margin: 0; }

  /* Tarjetas neutras de la paleta del sitio */
  .card { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 16px; padding: 24px 24px 22px; }
  .card-n { display: inline-block; font-family: var(--font-display); font-weight: 600; font-size: 14px; letter-spacing: 0.04em; color: var(--ink-muted); margin-bottom: 10px; }
  .card-t { font-family: var(--font-display); font-weight: 600; font-size: 21px; line-height: 1.25; margin: 0 0 8px; color: var(--ink); }
  .card-b { font-size: 15.5px; line-height: 1.65; color: var(--ink-soft); margin: 0; }

  .facts { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .fact { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 14px; padding: 18px 20px; }
  .fact-l { font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 6px; }
  .fact-v { font-size: 17px; line-height: 1.45; color: var(--ink); margin: 0; }

  .statement { font-family: var(--font-display); font-size: 27px; line-height: 1.4; color: var(--ink); margin: 0; max-width: 900px; font-variation-settings: "SOFT" 0, "WONK" 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { background: var(--surface-warm); border: 1px solid var(--line); color: var(--ink); font-size: 15px; padding: 9px 18px; border-radius: 999px; }

  .cards { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
  .steps { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .cols { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .col { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--surface); }
  .col-h { margin: 0; padding: 14px 20px; background: var(--surface-tag); border-bottom: 1px solid var(--line); color: var(--ink); font-family: var(--font-display); font-weight: 600; font-size: 19px; }
  .col-ul { margin: 0; padding: 18px 20px 14px 38px; }
  .col-ul li { font-size: 15px; line-height: 1.5; color: var(--ink-soft); margin-bottom: 8px; }

  .pairs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pairs.even { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .pair-dl { margin: 0; }
  .pair-dl dt { font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 6px; }
  .pair-dl dt.pair-b { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--ink); }
  .pair-dl dd { margin: 0; font-size: 15.5px; line-height: 1.65; color: var(--ink-soft); }

  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
  .flow-s { background: var(--surface-warm); border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .flow-n { width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--paper); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
  .flow-t { font-size: 14.5px; line-height: 1.45; color: var(--ink); }

  .big-quote { margin: 0; font-family: var(--font-display); font-size: 27px; line-height: 1.45; color: var(--ink); border-left: 4px solid var(--accent); padding-left: 24px; max-width: 900px; }

  .m-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .m-v { font-family: var(--font-display); font-weight: 400; font-size: 48px; line-height: 1; color: var(--ink); margin: 0 0 8px; }
  .m-l { font-size: 15px; line-height: 22px; color: var(--ink-soft); margin: 0; }

  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .gallery-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gallery-grid.one { grid-template-columns: minmax(0, 900px); }
  .gallery-grid figure { margin: 0; }
  .gallery-grid img { width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 12px; background: var(--line); }
  .gallery-grid figcaption { font-size: 13px; color: var(--ink-muted); margin-top: 8px; line-height: 18px; }

  .videos-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 0 auto; justify-content: center; max-width: 1100px; }
  .videos-grid.odd .video-card:last-child { grid-column: 1 / -1; width: calc(50% - 12px); justify-self: center; }
  .videos-grid.single { grid-template-columns: minmax(0, 900px); max-width: 900px; }
  .video-card { margin: 0; }
  .video-card figcaption { font-size: 14px; color: var(--ink-soft); margin-top: 10px; line-height: 20px; text-align: center; }
  .yt-frame, .local-video { width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; background: #000; display: block; overflow: hidden; }
  .video-card.vertical { width: 100%; max-width: 340px; justify-self: center; }
  .video-card.vertical .yt-frame { aspect-ratio: 9 / 16; }
  .yt-frame :global(iframe) { width: 100%; height: 100%; border: 0; }
  .yt-play { position: relative; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; background: #000; }
  .yt-play img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .yt-icon { position: absolute; inset: 0; margin: auto; width: 64px; height: 64px; border-radius: 50%; background: rgba(255,255,255,0.92); color: #111; display: flex; align-items: center; justify-content: center; font-size: 22px; padding-left: 4px; }
  .yt-play:hover .yt-icon { background: #fff; }

  .awards-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .awards-grid.one { grid-template-columns: minmax(0, 700px); }
  .award-card { background: var(--surface-warm); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 12px; padding: 20px 24px; }
  .award-img-link { display: block; margin-bottom: 14px; }
  .award-img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--line); }
  .award-title { font-family: var(--font-display); font-weight: 600; font-size: 20px; margin: 0 0 6px; color: var(--ink); }
  .award-detail { font-size: 14px; color: var(--ink-soft); margin: 0; }

  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 16px 28px; }
  .links li { margin: 0; }

  @media (max-width: 900px) {
    .wrap { padding-left: 20px; padding-right: 20px; }
    .vb { padding-top: 18px; padding-bottom: 18px; }
    .vb-chapter { padding-top: 28px; }
    .chapter-title { font-size: 28px; }
    .statement, .big-quote { font-size: 22px; }
    .m-grid { grid-template-columns: 1fr 1fr; }
    .pairs, .pairs.even, .awards-grid, .videos-grid, .videos-grid.single { grid-template-columns: minmax(0, 1fr); }
    .videos-grid.odd .video-card:last-child { width: 100%; }
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gallery-grid.one { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) { .gallery-grid, .gallery-grid.two { grid-template-columns: minmax(0, 1fr); } }
</style>
