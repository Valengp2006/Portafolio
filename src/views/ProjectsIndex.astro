---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { byTier, published } from "../data/projects";
import { pagePath, other, type Lang } from "../i18n";
import { ui, meta } from "../i18n/copy";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui.projectsPage;
const tiers = [byTier(1), byTier(2), byTier(3)];
const cats = ["ux", "interactive", "heritage"] as const;
---
<Layout
  lang={lang}
  title={`${t.title[lang]} — Valentina Garzón`}
  description={t.intro[lang]}
  active="projects"
  selfHref={pagePath(lang, "projects")}
  altHref={pagePath(other(lang), "projects")}
>
  <main>
    <section class="hero">
      <div class="wrap hero-wrap">
        <p class="eyebrow reveal">{t.eyebrow[lang]}</p>
        <h1 class="hero-title reveal">{t.title[lang]}</h1>
        <p class="hero-body reveal">{t.intro[lang]}</p>
        <div class="filters" id="filters" role="group" aria-label={t.filterLabel[lang]} hidden>
          <button type="button" class="filter is-on" data-cat="all" aria-pressed="true">{t.filterAll[lang]}</button>
          {cats.map((c) => <button type="button" class="filter" data-cat={c} aria-pressed="false">{t.cats[c][lang]}</button>)}
        </div>
        <p class="sr-only" id="filter-live" aria-live="polite"></p>
      </div>
    </section>

    <section class="grid-section">
      <div id="view-all">
      <div class="wrap tier-wrap">
        <h2 class="tier-title">{t.tier1[lang]}</h2>
        <div class="featured">
          {tiers[0][0] && <div class="reveal"><ProjectCard project={tiers[0][0]} layout="hero" lang={lang} /></div>}
          {tiers[0].length > 1 && (
            <div class="pair">
              {tiers[0].slice(1).map((p) => <div class="reveal"><ProjectCard project={p} layout="vertical" lang={lang} /></div>)}
            </div>
          )}
        </div>
      </div>
      {tiers[1].length > 0 && (
        <div class="wrap tier-wrap">
          <h2 class="tier-title">{t.tier2[lang]}</h2>
          <div class="tiles">
            {tiers[1].map((p) => <div class="reveal"><ProjectCard project={p} layout="tile" lang={lang} /></div>)}
          </div>
        </div>
      )}
      {tiers[2].length > 0 && (
        <div class="wrap tier-wrap">
          <h2 class="tier-title">{t.tier3[lang]}</h2>
          <p class="tier-intro">{t.tier3Intro[lang]}</p>
          <div class="stack-list">
            {tiers[2].map((p) => <div class="reveal"><ProjectCard project={p} layout="compact" lang={lang} /></div>)}
          </div>
        </div>
      )}
      </div>
      <div id="view-filtered" class="wrap tier-wrap" hidden>
        <div class="tiles">
          {published.map((p) => (
            <div data-cats={p.categories.join(" ")} hidden>
              <ProjectCard project={p} layout="tile" lang={lang} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{ countOne: t.countOne[lang], countMany: t.countMany[lang] }}>
    const bar = document.getElementById("filters");
    const viewAll = document.getElementById("view-all");
    const viewF = document.getElementById("view-filtered");
    const live = document.getElementById("filter-live");
    const items = [...document.querySelectorAll("#view-filtered [data-cats]")];
    const buttons = [...document.querySelectorAll(".filter")];
    function apply(cat) {
      buttons.forEach((b) => {
        const on = b.dataset.cat === cat;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", String(on));
      });
      if (cat === "all") {
        viewAll.hidden = false;
        viewF.hidden = true;
        live.textContent = "";
      } else {
        let n = 0;
        items.forEach((el) => {
          const show = el.dataset.cats.split(" ").includes(cat);
          el.hidden = !show;
          if (show) n++;
        });
        viewAll.hidden = true;
        viewF.hidden = false;
        live.textContent = n === 1 ? countOne : n + " " + countMany;
      }
      history.replaceState(null, "", cat === "all" ? location.pathname + location.search : "#" + cat);
    }
    if (bar) {
      bar.hidden = false;
      buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.cat)));
      const h = location.hash.slice(1);
      if (buttons.some((b) => b.dataset.cat === h)) apply(h);
    }
  </script>

  <style>
    /* VARIABLES EXACTAS DE FIGMA */
    :root {
      --figma-dark: #1F1B16;
      --figma-muted: #8A837A;
      --figma-soft: #57504A;
      --font-fraunces: 'Fraunces', serif;
      --font-inter: 'Inter', sans-serif;
    }

    /* CONTENEDOR GLOBAL RESPONSIVO */
    .wrap {
      max-width: 1513px;
      margin: 0 auto;
      padding: 45px 155px;
      width: 100%;
      box-sizing: border-box;
    }
    @media (max-width: 1000px) {
      .wrap { padding: 40px 20px; }
    }

    .eyebrow {
      font-family: var(--font-fraunces);
      font-weight: 600;
      font-size: 18px;
      line-height: 26px;
      color: var(--figma-muted);
      margin: 0 0 16px 0;
    }

    /* --- HERO --- */
    .hero-wrap { 
      display: flex; 
      flex-direction: column; 
      align-items: flex-start;
      padding-bottom: 24px; /* Ajuste para equilibrar el espacio con el grid */
    }
    .hero-title { 
      font-family: var(--font-fraunces); 
      font-weight: 400; 
      font-size: 72px; 
      line-height: 72px; 
      color: var(--figma-dark);
      margin: 0 0 42px 0; 
    }
    .hero-body { 
      font-family: var(--font-inter);
      font-size: 18px; 
      line-height: 30px; 
      color: var(--figma-soft); 
      max-width: 860px; 
      margin: 0; 
    }
    
    @media (max-width: 1000px) {
      .hero-title { font-size: 44px; line-height: 50px; margin: 0 0 24px 0; }
    }

    /* --- GRID DE PROYECTOS --- */
    .grid-wrap { 
      display: grid; 
      grid-template-columns: repeat(2, 1fr); 
      gap: 60px 40px; 
      padding-top: 0; 
      padding-bottom: 96px;
    }
    
    @media (max-width: 1000px) {
      .grid-wrap { grid-template-columns: 1fr; gap: 40px; padding-top: 24px; }
    }
  
    .tier-title { font-family: var(--font-fraunces); font-weight: 600; font-size: 24px; color: var(--figma-muted); margin: 0 0 8px; }
    .tier-intro { font-family: var(--font-inter); font-size: 16px; color: var(--figma-soft); margin: 0 0 24px; }
    .tier-wrap { padding-top: 24px; padding-bottom: 24px; }
    .stack-list { display: flex; flex-direction: column; gap: 12px; }
    .featured { display: flex; flex-direction: column; gap: 24px; }
    .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .tier-wrap { padding-top: 32px; padding-bottom: 32px; }
    @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 760px) { .pair, .tiles { grid-template-columns: 1fr; } }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
    .filters[hidden] { display: none; }
    .filter { font-family: var(--font-inter); font-size: 13.5px; font-weight: 500; line-height: 1; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line, #E4DFD6); background: transparent; color: var(--figma-soft); cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s; }
    .filter:hover { border-color: var(--figma-muted); color: var(--figma-dark); }
    .filter.is-on { background: var(--figma-dark); border-color: var(--figma-dark); color: #FAF7F2; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: -1px; padding: 0; border: 0; }
</style>
</Layout>
