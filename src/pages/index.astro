---
import { pagePath } from "../i18n";
const es = pagePath("es", "home");
const en = pagePath("en", "home");
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${es}`} />
    <link rel="canonical" href={es} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Valentina Garzón</title>
    <script is:inline define:vars={{ es, en }}>
      var l = (navigator.language || "es").toLowerCase();
      location.replace(l.indexOf("es") === 0 ? es : en);
    </script>
  </head>
  <body>
    <p><a href={es}>Español</a> · <a href={en}>English</a></p>
  </body>
</html>
